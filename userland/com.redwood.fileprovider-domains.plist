<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.redwood.fileprovider-domains</string>
	<key>UserName</key>
	<string>mobile</string>
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/tolog</string>
		<string>/usr/bin/fileproviderctl</string>
		<string>domain</string>
		<string>list</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>30</integer>
</dict>
</plist>
